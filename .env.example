# ==========================================
# Quick kart - Environment Variables Template
# Copy this file to .env and fill your own values
# NEVER commit .env to GitHub
# ==========================================

# Backend Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=quickkart_db
DB_USERNAME=root
DB_PASSWORD=

# JWT Security (Use a minimum 64-character random secret in production)
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Initial Owner Bootstrap (Set your private store owner credentials on first startup)
APP_BOOTSTRAP_OWNER_NAME=Store Owner
APP_BOOTSTRAP_OWNER_EMAIL=
APP_BOOTSTRAP_OWNER_PASSWORD=

# CORS Allowed Origins (Comma-separated, e.g. https://your-project.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Swagger Docs (Keep false in production)
SWAGGER_ENABLED=false

# Cloudinary Image Storage (Leave empty for local disk upload fallback in dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Payment Gateway (Test Mode keys; falls back to simulated test mode if empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Mail / SMTP Configuration (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Frontend (Vite / Vercel)
VITE_API_BASE_URL=http://localhost:8080/api
VITE_RAZORPAY_KEY_ID=
